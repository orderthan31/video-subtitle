# Copy selected values into your own .env.docker. No API keys belong here.
# Runtime choice: cpu, cuda (required), or auto (CUDA when available, else CPU).
NVIDIA_VAD_DEVICE=cpu
NVIDIA_VAD_BATCH_SIZE=64
# GPU builds only; keep torch version and wheel index compatible.
# VAD_TORCH_VERSION=2.11.0+cu128
# VAD_TORCHAUDIO_VERSION=2.11.0+cu128
# VAD_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
